function Icon({ name, className = "h-4 w-4", strokeWidth = 1.8, style }) {
  return (
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      strokeWidth={strokeWidth}
      strokeLinecap="round"
      strokeLinejoin="round"
      className={className}
      style={style}
      aria-hidden="true"
    >
      {ICONS[name]}
    </svg>
  );
}

/* ────────────────────────────────────────────────────────────────────────── */
/* Small primitives                                                          */
/* ────────────────────────────────────────────────────────────────────────── */

function Counter({ to, duration = 1.4, delay = 0.35 }) {
  const [value, setValue] = useState(0);
  useEffect(() => {
    const controls = animate(0, to, { duration, delay, ease: EASE, onUpdate: (v) => setValue(Math.round(v)) });
    return () => controls.stop();
  }, [to, duration, delay]);
  return value;
}

function useTicker(start) {
  const [seconds, setSeconds] = useState(start);
  useEffect(() => {
    const id = setInterval(() => setSeconds((s) => s + 1), 1000);
    return () => clearInterval(id);
  }, []);
  return seconds;
}

const Card = ({ className = "", style, children }) => (
  <div
    className={`rounded-2xl border border-white/[0.08] bg-white/[0.045] p-3.5 backdrop-blur-md ${className}`}
    style={style}
  >
    {children}
  </div>
);

const Eyebrow = ({ children, className = "" }) => (
  <p className={`text-[9.5px] font-medium uppercase tracking-[0.16em] text-white/45 ${className}`}>{children}</p>
);

const PulseDot = ({ color, className = "h-1.5 w-1.5" }) => (
  <span className={`relative inline-flex ${className}`}>
    <span className="absolute inset-0 animate-ping rounded-full opacity-70" style={{ background: color }} />
    <span className="relative inline-flex h-full w-full rounded-full" style={{ background: color, boxShadow: `0 0 8px ${color}` }} />
  </span>
);

const Caret = ({ accent }) => (
  <motion.span
    className="ml-1 inline-block h-3.5 w-[7px] translate-y-[2px]"
    style={{ background: accent.hex, boxShadow: `0 0 8px ${accent.hex}` }}
    animate={{ opacity: [1, 0] }}
    transition={{ duration: 0.7, repeat: Infinity, repeatType: "reverse" }}
  />
);

/* ────────────────────────────────────────────────────────────────────────── */
/* Phone screen widgets                                                      */
/* ────────────────────────────────────────────────────────────────────────── */

function MetricCard({ el, accent }) {
  const [num, ...unit] = el.value.split(" ");
  const bars = [42, 68, 55, 81, 60, 92, 74];
  const days = ["M", "T", "W", "T", "F", "S", "S"];
  return (
    <Card>
      <div className="flex items-center justify-between">
        <Eyebrow>{el.title}</Eyebrow>
        <Icon name="activity" className="h-3.5 w-3.5" style={{ color: accent.hex }} />
      </div>
      <div className="mt-2.5 flex items-end justify-between gap-3">
        <div>
          <p className="text-[26px] font-semibold leading-none tracking-tight text-white">
            {num} <span className="text-xs font-medium text-white/50">{unit.join(" ")}</span>
          </p>
          <p className="mt-2.5 flex items-center gap-1.5 text-[10px] text-white/55">
            <span className="h-1.5 w-1.5 rounded-full bg-emerald-400 shadow-[0_0_6px_#34d399]" />
            {el.sub}
          </p>
        </div>
        <div className="flex gap-[4px]">
          {bars.map((h, i) => {
            const isToday = i === bars.length - 1;
            return (
              <div key={i} className="flex flex-col items-center gap-1">
                <div className="flex h-11 items-end">
                  <motion.span
                    className="block w-[6px] origin-bottom rounded-full"
                    style={{
                      height: `${h}%`,
                      background: isToday ? accent.hex : "rgba(255,255,255,0.16)",
                      boxShadow: isToday ? `0 0 10px ${alpha(accent, 0.8)}` : "none",
                    }}
                    initial={{ scaleY: 0 }}
                    animate={{ scaleY: 1 }}
                    transition={{ delay: 0.35 + i * 0.05, duration: 0.6, ease: EASE }}
                  />
                </div>
                <span className={`text-[7.5px] ${isToday ? "text-white/80" : "text-white/30"}`}>{days[i]}</span>
              </div>
            );
          })}
        </div>
      </div>
    </Card>
  );
}

function ProgressRing({ el, accent }) {
  const [label, status] = el.label.split(":").map((s) => s.trim());
  const r = 40;
  return (
    <Card className="flex items-center gap-4">
      <div className="relative h-[104px] w-[104px] shrink-0">
        <svg viewBox="0 0 100 100" className="h-full w-full -rotate-90">
          <circle cx="50" cy="50" r={r} fill="none" stroke="rgba(255,255,255,0.07)" strokeWidth="8" />
          <circle cx="50" cy="50" r={r - 13} fill="none" stroke="rgba(255,255,255,0.04)" strokeWidth="1" strokeDasharray="1 3" />
          <motion.circle
            cx="50"
            cy="50"
            r={r}
            fill="none"
            stroke={accent.hex}
            strokeWidth="8"
            strokeLinecap="round"
            initial={{ pathLength: 0 }}
            animate={{ pathLength: el.percentage / 100 }}
            transition={{ duration: 1.4, ease: EASE, delay: 0.35 }}
            style={{ filter: `drop-shadow(0 0 5px ${alpha(accent, 0.9)})` }}
          />
        </svg>
        <div className="absolute inset-0 flex flex-col items-center justify-center">
          <span className="text-[26px] font-semibold leading-none tracking-tight text-white">
            <Counter to={el.percentage} />
          </span>
          <span className="mt-1 text-[8px] uppercase tracking-[0.2em] text-white/40">of 100</span>
        </div>
      </div>
      <div className="min-w-0">
        <Eyebrow>{label}</Eyebrow>
        <p className="mt-1 text-lg font-semibold" style={{ color: accent.hex }}>
          {status}
        </p>
        <p className="mt-1.5 text-[10px] leading-snug text-white/45">Scored from synced wearable data</p>
      </div>
    </Card>
  );
}

function AiBubble({ el, accent }) {
  const [sender, ...rest] = el.text.split(":");
  const message = rest.join(":").trim();
  const [typing, setTyping] = useState(true);
  useEffect(() => {
    const id = setTimeout(() => setTyping(false), 1900);
    return () => clearTimeout(id);
  }, []);

  return (
    <motion.div
      animate={{ y: [0, -4, 0] }}
      transition={{ duration: 4, repeat: Infinity, ease: "easeInOut" }}
      className="flex items-end gap-2"
    >
      <div
        className="grid h-8 w-8 shrink-0 place-items-center rounded-full"
        style={{
          background: `linear-gradient(135deg, ${accent.hex}, ${alpha(accent, 0.45)})`,
          boxShadow: `0 0 18px ${alpha(accent, 0.6)}`,
        }}
      >
        <Icon name="sparkle" className="h-4 w-4 text-slate-950" strokeWidth={2.2} />
      </div>
      <div
        className="min-w-0 flex-1 rounded-2xl rounded-bl-md border px-3 py-2.5 backdrop-blur-xl"
        style={{ borderColor: alpha(accent, 0.3), background: "rgba(4,20,22,0.72)", boxShadow: `0 10px 30px -10px ${alpha(accent, 0.45)}` }}
      >
        <p className="text-[9px] font-semibold uppercase tracking-[0.16em]" style={{ color: accent.hex }}>
          {sender}
        </p>
        <AnimatePresence mode="wait" initial={false}>
          {typing ? (
            <motion.div key="typing" exit={{ opacity: 0 }} className="flex gap-1 py-1.5">
              {[0, 1, 2].map((i) => (
                <motion.span
                  key={i}
                  className="h-1.5 w-1.5 rounded-full bg-white/60"
                  animate={{ opacity: [0.3, 1, 0.3], y: [0, -2, 0] }}
                  transition={{ duration: 0.9, repeat: Infinity, delay: i * 0.15 }}
                />
              ))}
            </motion.div>
          ) : (
            <motion.p
              key="msg"
              initial={{ opacity: 0, y: 4 }}
              animate={{ opacity: 1, y: 0 }}
              className="mt-0.5 text-[11.5px] leading-snug text-white/90"
            >
              {message}
            </motion.p>
          )}
        </AnimatePresence>
      </div>
    </motion.div>
  );
}

function ActiveCall({ el, accent }) {
  const match = el.status.match(/^(.*?)\s*\((\d+):(\d+)\)/);
  const label = match ? match[1] : el.status;
  const seconds = useTicker(match ? Number(match[2]) * 60 + Number(match[3]) : 0);
  const clock = `${String(Math.floor(seconds / 60)).padStart(2, "0")}:${String(seconds % 60).padStart(2, "0")}`;
  const initials = el.doctor
    .replace(/^Dr\.?\s*/, "")
    .split(" ")
    .map((w) => w[0])
    .join("");

  return (
    <Card className="overflow-hidden p-0">
      <div
        className="relative grid h-[128px] place-items-center"
        style={{ background: `radial-gradient(circle at 50% 45%, ${alpha(accent, 0.32)}, transparent 62%), linear-gradient(180deg,#0b1630,#060a14)` }}
      >
        <div className="relative">
          {[0, 1].map((i) => (
            <motion.span
              key={i}
              className="absolute inset-0 rounded-full border"
              style={{ borderColor: alpha(accent, 0.6) }}
              animate={{ scale: [1, 1.7], opacity: [0.6, 0] }}
              transition={{ duration: 2.2, repeat: Infinity, delay: i * 1.1, ease: "easeOut" }}
            />
          ))}
          <div
            className="relative grid h-16 w-16 place-items-center rounded-full text-lg font-semibold text-white"
            style={{ background: `linear-gradient(135deg, ${accent.hex}, #1e3a8a)`, boxShadow: `0 0 30px ${alpha(accent, 0.5)}` }}
          >
            {initials}
          </div>
        </div>
        <div className="absolute right-2.5 top-2.5 grid h-14 w-10 place-items-center rounded-lg border border-white/15 bg-slate-800/80 text-white/40">
          <Icon name="user" className="h-4 w-4" />
        </div>
        <span className="absolute left-2.5 top-2.5 rounded-md bg-black/40 px-1.5 py-0.5 font-mono text-[8.5px] tracking-wider text-white/70">
          HD · VIDEO
        </span>
        <div className="absolute bottom-2.5 left-2.5 flex gap-1.5">
          {["mic", "video"].map((n) => (
            <span key={n} className="grid h-7 w-7 place-items-center rounded-full bg-white/10 text-white/80 backdrop-blur">
              <Icon name={n} className="h-3.5 w-3.5" />
            </span>
          ))}
        </div>
      </div>
      <div className="flex items-center justify-between gap-2 px-3.5 py-2.5">
        <div className="min-w-0">
          <p className="truncate text-[13px] font-semibold text-white">{el.doctor}</p>
          <p className="mt-0.5 flex items-center gap-1.5 whitespace-nowrap text-[10.5px] text-emerald-300">
            <PulseDot color="#34d399" />
            {label} ({clock})
          </p>
        </div>
        <span className="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-rose-500 text-white shadow-[0_0_14px_rgba(244,63,94,0.55)]">
          <Icon name="phoneOff" className="h-4 w-4" />
        </span>
      </div>
    </Card>
  );
}

function ClaimStatus({ el, accent }) {
  const steps = ["Submitted", "In Review", "Verified"];
  return (
    <Card>
      <div className="flex items-center justify-between">
        <Eyebrow>Claim Tracker</Eyebrow>
        <span className="font-mono text-[10px] text-white/60">{el.id}</span>
      </div>
      <div className="mt-2 flex items-center gap-2">
        <span className="grid h-5 w-5 place-items-center rounded-full bg-emerald-400/15 text-emerald-300">
          <Icon name="check" className="h-3 w-3" strokeWidth={2.6} />
        </span>
        <p className="text-[13px] font-semibold text-white">{el.status}</p>
        <span className="ml-auto font-mono text-[11px]" style={{ color: accent.hex }}>
          <Counter to={el.progress} />%
        </span>
      </div>
      <div className="mt-3 h-1.5 overflow-hidden rounded-full bg-white/10">
        <motion.div
          className="h-full rounded-full"
          style={{ background: `linear-gradient(90deg, ${alpha(accent, 0.45)}, ${accent.hex})`, boxShadow: `0 0 10px ${alpha(accent, 0.7)}` }}
          initial={{ width: 0 }}
          animate={{ width: `${el.progress}%` }}
          transition={{ duration: 1.3, delay: 0.4, ease: EASE }}
        />
      </div>
      <div className="mt-2 flex justify-between">
        {steps.map((s, i) => {
          const reached = el.progress >= (i / (steps.length - 1)) * 100;
          return (
            <span key={s} className={`text-[8.5px] uppercase tracking-wider ${reached ? "text-white/70" : "text-white/30"}`}>
              {s}
            </span>
          );
        })}
      </div>
    </Card>
  );
}

const QUICK_ACTION_ICONS = { "Book Lab Test": "flask", "Coupon Applied": "tag" };

function QuickActionGrid({ el, accent }) {
  return (
    <div className="grid grid-cols-2 gap-2">
      {el.items.map((item) => (
        <Card key={item} className="flex items-center gap-2.5 p-3">
          <span
            className="grid h-8 w-8 shrink-0 place-items-center rounded-xl"
            style={{ background: alpha(accent, 0.14), color: accent.hex }}
          >
            <Icon name={QUICK_ACTION_ICONS[item] ?? "sparkle"} className="h-4 w-4" />
          </span>
          <span className="text-[11px] font-medium leading-tight text-white/85">{item}</span>
        </Card>
      ))}
    </div>
  );
}

function MapWidget({ el, accent }) {
  const cols = [
    [8, 54],
    [72, 41],
    [123, 50],
    [183, 55],
  ];
  const rows = [
    [8, 40],
    [59, 47],
    [117, 37],
  ];
  const pin = { x: 148, y: 82 };

  return (
    <Card className="overflow-hidden p-0">
      <div className="relative h-[160px]">
        <svg viewBox="0 0 246 160" preserveAspectRatio="none" className="absolute inset-0 h-full w-full">
          <rect width="246" height="160" fill="#0f0c07" />
          {rows.map(([y, h], ri) =>
            cols.map(([x, w], ci) => (
              <rect
                key={`${ri}-${ci}`}
                x={x}
                y={y}
                width={w}
                height={h}
                rx="4"
                fill={ri === 1 && ci === 1 ? "rgba(52,211,153,0.09)" : "rgba(255,255,255,0.035)"}
              />
            ))
          )}
          <path d="M0 52H246M0 110H246M66 0V160M117 0V160M177 0V160" stroke="rgba(255,255,255,0.07)" strokeWidth="6" />
          <circle
            cx={pin.x}
            cy={pin.y}
            r="30"
            fill={alpha(accent, 0.07)}
            stroke={alpha(accent, 0.55)}
            strokeWidth="1"
            strokeDasharray="3 3"
          />
          <motion.path
            d={`M66 156V110H117V${pin.y}H${pin.x}`}
            fill="none"
            stroke={accent.hex}
            strokeWidth="3"
            strokeLinecap="round"
            strokeLinejoin="round"
            initial={{ pathLength: 0 }}
            animate={{ pathLength: 1 }}
            transition={{ duration: 1.6, delay: 0.4, ease: "easeInOut" }}
            style={{ filter: `drop-shadow(0 0 4px ${accent.hex})` }}
          />
          <circle cx="66" cy="156" r="3.5" fill="#fff" />
          <motion.circle
            cx={pin.x}
            cy={pin.y}
            fill={accent.hex}
            initial={{ r: 5, opacity: 0.6 }}
            animate={{ r: [5, 22], opacity: [0.6, 0] }}
            transition={{ duration: 1.8, repeat: Infinity, ease: "easeOut" }}
          />
          <circle cx={pin.x} cy={pin.y} r="5" fill={accent.hex} stroke="#fff" strokeWidth="2" />
        </svg>
        <span className="absolute left-2.5 top-2.5 flex items-center gap-1.5 rounded-full bg-black/60 px-2 py-1 text-[9.5px] font-medium text-white/85 backdrop-blur">
          <PulseDot color={accent.hex} />
          {el.status}
        </span>
      </div>
      <div className="flex items-center gap-2.5 px-3.5 py-3">
        <span className="grid h-8 w-8 shrink-0 place-items-center rounded-xl" style={{ background: alpha(accent, 0.14), color: accent.hex }}>
          <Icon name="pin" className="h-4 w-4" />
        </span>
        <div className="min-w-0">
          <p className="truncate text-[12.5px] font-semibold text-white">{el.location}</p>
          <p className="text-[10px] text-white/45">Inside geo-fence radius</p>
        </div>
      </div>
    </Card>
  );
}

function NotificationBanner({ el, accent, project }) {
  return (
    <motion.div
      initial={{ y: -24, opacity: 0 }}
      animate={{ y: 0, opacity: 1 }}
      transition={{ delay: 0.9, type: "spring", stiffness: 320, damping: 24 }}
      className="flex items-center gap-3 rounded-[20px] border border-white/10 bg-neutral-900/75 p-3 shadow-2xl backdrop-blur-xl"
    >
      <motion.span
        className="grid h-9 w-9 shrink-0 place-items-center rounded-xl text-slate-950"
        style={{ background: accent.hex, boxShadow: `0 0 16px ${alpha(accent, 0.55)}` }}
        animate={{ rotate: [0, -14, 12, -8, 0] }}
        transition={{ delay: 1.3, duration: 0.7 }}
      >
        <Icon name="bell" className="h-4 w-4" strokeWidth={2.2} />
      </motion.span>
      <div className="min-w-0 flex-1">
        <div className="flex items-center justify-between gap-2">
          <p className="truncate text-[9.5px] uppercase tracking-[0.14em] text-white/45">{project.phoneScreenMock.header}</p>
          <p className="shrink-0 text-[9.5px] text-white/40">{el.time}</p>
        </div>
        <p className="mt-0.5 text-[12.5px] font-semibold text-white">{el.title}</p>
      </div>
    </motion.div>
  );
}

const STAT_ROW_ICONS = { leads: "users", meetings: "calendar" };

function StatRow({ el, accent }) {
  const entries = Object.entries(el).filter(([key]) => key !== "type");
  return (
    <div className="grid grid-cols-2 gap-2">
      {entries.map(([key, raw]) => {
        const [num, ...rest] = String(raw).split(" ");
        return (
          <Card key={key} className="p-3">
            <div className="flex items-center justify-between">
              <Eyebrow>{key}</Eyebrow>
              <Icon name={STAT_ROW_ICONS[key] ?? "chart"} className="h-3.5 w-3.5 text-white/35" />
            </div>
            <div className="mt-2 flex items-baseline gap-2">
              <span className="text-[26px] font-semibold leading-none tracking-tight text-white">
                <Counter to={Number(num) || 0} duration={1} />
              </span>
              <span className="rounded-full px-1.5 py-0.5 text-[9px] font-medium" style={{ background: alpha(accent, 0.14), color: accent.hex }}>
                {rest.join(" ")}
              </span>
            </div>
          </Card>
        );
      })}
    </div>
  );
}

function HackathonBadge({ el, accent }) {
  const spaceAt = el.text.indexOf(" ");
  const emoji = el.text.slice(0, spaceAt);
  const [title, event] = el.text.slice(spaceAt + 1).split(" - ");
  return (
    <div
      className="relative overflow-hidden rounded-2xl p-px"
      style={{ background: `linear-gradient(120deg, ${alpha(accent, 0.8)}, rgba(255,255,255,0.08), ${alpha(accent, 0.8)})` }}
    >
      <div className="relative flex items-center gap-3 overflow-hidden rounded-[15px] bg-[#130a1d] px-3.5 py-3">
        <motion.span
          className="text-2xl"
          animate={{ rotate: [0, -10, 10, 0], scale: [1, 1.1, 1] }}
          transition={{ duration: 1.2, delay: 0.6, repeat: Infinity, repeatDelay: 2.4 }}
        >
          {emoji}
        </motion.span>
        <div className="min-w-0">
          <p className="text-[13px] font-semibold text-white">{title}</p>
          <p className="text-[9.5px] uppercase tracking-[0.16em]" style={{ color: accent.hex }}>
            {event}
          </p>
        </div>
        <motion.span
          className="pointer-events-none absolute inset-y-0 w-1/3 -skew-x-12 bg-gradient-to-r from-transparent via-white/15 to-transparent"
          initial={{ x: "-150%" }}
          animate={{ x: "400%" }}
          transition={{ duration: 1.6, repeat: Infinity, repeatDelay: 1.8, ease: "easeInOut" }}
        />
      </div>
    </div>
  );
}

function OcrScanner({ el, accent }) {
  const [score, ...scoreLabel] = el.accuracy.split(" ");
  const box = (className, delay) => (
    <motion.span
      className={`absolute rounded-md border-[1.5px] ${className}`}
      style={{ borderColor: accent.hex, background: alpha(accent, 0.1), boxShadow: `0 0 10px ${alpha(accent, 0.5)}` }}
      initial={{ opacity: 0, scale: 1.15 }}
      animate={{ opacity: 1, scale: 1 }}
      transition={{ delay, duration: 0.4, ease: EASE }}
    />
  );

  return (
    <Card className="p-3">
      <div className="relative h-[150px] overflow-hidden rounded-xl bg-[#ece8e1] p-3">
        <div className="flex items-start justify-between">
          <div>
            <div className="h-2 w-14 rounded-sm bg-slate-800" />
            <div className="mt-1.5 h-1.5 w-20 rounded-sm bg-slate-400/70" />
            <div className="mt-1 h-1.5 w-16 rounded-sm bg-slate-400/50" />
          </div>
          <div className="relative h-11 w-9 overflow-hidden rounded-md bg-slate-300">
            <div className="absolute left-1/2 top-2 h-4 w-4 -translate-x-1/2 rounded-full bg-slate-500" />
            <div className="absolute -bottom-2 left-1/2 h-5 w-8 -translate-x-1/2 rounded-full bg-slate-500" />
          </div>
        </div>
        <div className="mt-3.5 space-y-1.5">
          {[92, 78, 85, 60].map((w, i) => (
            <div key={i} className="h-1.5 rounded-sm bg-slate-400/45" style={{ width: `${w}%` }} />
          ))}
        </div>
        <div className="absolute inset-x-3 bottom-3 flex items-center justify-between">
          <div className="h-2 w-16 rounded-sm bg-slate-400/60" />
          <div className="h-2.5 w-12 rounded-sm bg-slate-800" />
        </div>

        {box("left-2 top-2 h-[34px] w-[92px]", 0.9)}
        {box("right-2 top-2 h-[52px] w-[44px]", 1.2)}
        {box("bottom-2 right-2 h-[18px] w-[56px]", 1.5)}

        <motion.div
          className="pointer-events-none absolute inset-x-0 h-10"
          style={{ background: `linear-gradient(180deg, transparent, ${alpha(accent, 0.28)})`, borderBottom: `2px solid ${accent.hex}`, boxShadow: `0 6px 16px ${alpha(accent, 0.6)}` }}
          animate={{ top: ["-25%", "80%"] }}
          transition={{ duration: 2, repeat: Infinity, repeatType: "reverse", ease: "easeInOut" }}
        />
        {["left-1 top-1 border-l-2 border-t-2", "right-1 top-1 border-r-2 border-t-2", "bottom-1 left-1 border-b-2 border-l-2", "bottom-1 right-1 border-b-2 border-r-2"].map((c) => (
          <span key={c} className={`absolute h-4 w-4 rounded-[3px] ${c}`} style={{ borderColor: accent.hex }} />
        ))}
      </div>
      <div className="mt-3 flex items-center justify-between gap-2">
        <div className="flex min-w-0 items-center gap-1.5 text-white/60">
          <Icon name="file" className="h-3.5 w-3.5 shrink-0" />
          <span className="truncate font-mono text-[10px]">{el.filename}</span>
        </div>
        <span className="shrink-0 rounded-full px-2 py-0.5 font-mono text-[10px] font-medium" style={{ background: alpha(accent, 0.15), color: accent.hex }}>
          {score} <span className="text-white/50">{scoreLabel.join(" ")}</span>
        </span>
      </div>
    </Card>
  );
}

function ProcessingBar({ el, accent }) {
  const [done, setDone] = useState(false);
  return (
    <Card>
      <div className="flex items-center gap-2">
        <span className="grid h-6 w-6 place-items-center rounded-lg" style={{ background: alpha(accent, 0.15), color: accent.hex }}>
          <Icon name={done ? "check" : "zap"} className="h-3.5 w-3.5" strokeWidth={2.2} />
        </span>
        <AnimatePresence mode="wait" initial={false}>
          <motion.p
            key={done ? "done" : "busy"}
            initial={{ opacity: 0, y: 4 }}
            animate={{ opacity: 1, y: 0 }}
            exit={{ opacity: 0, y: -4 }}
            className={`text-[12px] font-semibold ${done ? "text-white" : "text-white/70"}`}
          >
            {done ? el.status : "Extracting fields…"}
          </motion.p>
        </AnimatePresence>
        <span className="ml-auto font-mono text-[11px]" style={{ color: accent.hex }}>
          <Counter to={100} duration={2} delay={0.5} />%
        </span>
      </div>
      <div className="mt-2.5 h-1.5 overflow-hidden rounded-full bg-white/10">
        <motion.div
          className="h-full rounded-full"
          style={{ background: `linear-gradient(90deg, ${alpha(accent, 0.4)}, ${accent.hex})`, boxShadow: `0 0 10px ${alpha(accent, 0.7)}` }}
          initial={{ width: 0 }}
          animate={{ width: "100%" }}
          transition={{ duration: 2, delay: 0.5, ease: EASE }}
          onAnimationComplete={() => setDone(true)}
        />
      </div>
    </Card>
  );
}

const WIDGETS = {
  metricCard: MetricCard,
  progressRing: ProgressRing,
  aiBubble: AiBubble,
  activeCall: ActiveCall,
  claimStatus: ClaimStatus,
  quickActionGrid: QuickActionGrid,
  mapWidget: MapWidget,
  notificationBanner: NotificationBanner,
  statRow: StatRow,
  hackathonBadge: HackathonBadge,
  ocrScanner: OcrScanner,
  processingBar: ProcessingBar,
};

/* ────────────────────────────────────────────────────────────────────────── */
/* iPhone mockup                                                             */
/* ────────────────────────────────────────────────────────────────────────── */

const TODAY = new Date().toLocaleDateString("en-US", { weekday: "short", day: "numeric", month: "short" });

function AppScreen({ project, accent }) {
  const mock = project.phoneScreenMock;
  return (
    <div className="flex h-full flex-col px-4 pt-12">
      <header className="flex items-center justify-between py-3">
        <div>
          <p className="text-[9.5px] font-medium uppercase tracking-[0.18em] text-white/40">{TODAY}</p>
          <h3 className="mt-0.5 text-[19px] font-semibold tracking-tight text-white">{mock.header}</h3>
        </div>
        <span
          className="grid h-9 w-9 place-items-center rounded-full border text-[11px] font-semibold text-white"
          style={{ borderColor: alpha(accent, 0.5), background: alpha(accent, 0.12), boxShadow: `0 0 14px ${alpha(accent, 0.3)}` }}
        >
          RS
        </span>
      </header>

      <motion.div variants={screenStagger} initial="hidden" animate="show" className="flex flex-1 flex-col gap-3">
        {mock.uiElements.map((el, i) => {
          const Widget = WIDGETS[el.type];
          if (!Widget) return null;
          return (
            <motion.div key={`${el.type}-${i}`} variants={screenItem} className={el.type === "aiBubble" ? "mt-auto" : ""}>
              <Widget el={el} accent={accent} project={project} />
            </motion.div>
          );
        })}
      </motion.div>

      <nav className="mb-6 mt-3 flex items-center justify-around rounded-2xl border border-white/[0.06] bg-black/30 px-2 py-2 backdrop-blur-xl">
        {["home", "chart", "chat", "user"].map((name, i) => (
          <span
            key={name}
            className="grid h-8 w-10 place-items-center rounded-xl"
            style={i === 0 ? { color: accent.hex, background: alpha(accent, 0.12) } : { color: "rgba(255,255,255,0.35)" }}
          >
            <Icon name={name} className="h-[18px] w-[18px]" />
          </span>
        ))}
      </nav>
    </div>
  );
}

function StatusBar() {
  return (
    <div className="pointer-events-none absolute inset-x-0 top-0 z-30 grid h-12 grid-cols-[1fr_104px_1fr] items-center pt-1 text-[13px] font-semibold text-white">
      <span className="text-center">9:41</span>
      <span />
      <span className="flex items-center justify-center gap-1.5">
        <svg viewBox="0 0 18 12" className="h-[10px] w-[16px]" fill="currentColor" aria-hidden="true">
          {[0, 1, 2, 3].map((i) => (
            <rect key={i} x={i * 4.7} y={9 - i * 3} width="3" height={3 + i * 3} rx="0.8" />
          ))}
        </svg>
        <svg viewBox="0 0 16 12" className="h-[10px] w-[14px]" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" aria-hidden="true">
          <path d="M1 4.2a10.5 10.5 0 0 1 14 0M3.5 7a6.5 6.5 0 0 1 9 0" />
          <circle cx="8" cy="10" r="1.2" fill="currentColor" stroke="none" />
        </svg>
        <span className="relative flex h-[11px] w-[23px] items-center rounded-[3.5px] border border-white/50 p-[1.5px]">
          <span className="h-full w-[78%] rounded-[1.5px] bg-white" />
          <span className="absolute -right-[3px] top-1/2 h-1 w-[1.5px] -translate-y-1/2 rounded-r bg-white/50" />
        </span>
      </span>
    </div>
  );
}

function DynamicIsland({ project, accent }) {
  const [expanded, setExpanded] = useState(false);
  useEffect(() => {
    setExpanded(true);
    const id = setTimeout(() => setExpanded(false), 1500);
    return () => clearTimeout(id);
  }, [project.id]);

  return (
    <div className="pointer-events-none absolute inset-x-0 top-[11px] z-40 flex justify-center">
      <motion.div
        className="flex items-center justify-between overflow-hidden rounded-full bg-black px-3"
        animate={{ width: expanded ? 200 : 96, height: expanded ? 34 : 28 }}
        transition={{ type: "spring", stiffness: 380, damping: 30 }}
      >
        <AnimatePresence>
          {expanded && (
            <motion.div
              className="flex w-full items-center justify-between"
              initial={{ opacity: 0 }}
              animate={{ opacity: 1, transition: { delay: 0.12 } }}
              exit={{ opacity: 0, transition: { duration: 0.1 } }}
            >
              <span className="flex items-center gap-1.5 text-[10px] font-semibold text-white">
                <span className="h-2 w-2 rounded-full" style={{ background: accent.hex, boxShadow: `0 0 8px ${accent.hex}` }} />
                {project.phoneScreenMock.header}
              </span>
              <span className="font-mono text-[9px]" style={{ color: accent.hex }}>
                live
              </span>
            </motion.div>
          )}
        </AnimatePresence>
      </motion.div>
    </div>
  );
}

function ScreenSkeleton({ accent }) {
  return (
    <motion.div
      aria-hidden
      className="absolute inset-0 overflow-hidden bg-[#0b0d12]"
      exit={{ opacity: 0 }}
      transition={{ duration: 0.35, ease: EASE }}
    >
      <div className="flex h-full animate-pulse flex-col gap-3 px-5 pt-16">
        <div className="h-2.5 w-20 rounded-full bg-white/[0.07]" />
        <div className="h-6 w-40 rounded-lg bg-white/[0.09]" />
        <div className="mt-2 h-36 rounded-2xl bg-white/[0.06]" />
        <div className="grid grid-cols-4 gap-2.5">
          {Array.from({ length: 8 }, (_, i) => (
            <div key={i} className="aspect-square rounded-xl bg-white/[0.06]" />
          ))}
        </div>
        <div className="h-24 rounded-2xl bg-white/[0.05]" />
        <div className="mb-9 mt-auto h-12 rounded-2xl bg-white/[0.05]" />
      </div>
      <motion.div
        className="absolute inset-y-0 -left-1/2 w-1/2 -skew-x-12"
        style={{ background: `linear-gradient(90deg, transparent, ${alpha(accent, 0.08)}, rgba(255,255,255,0.06), transparent)` }}
        animate={{ x: ["0%", "400%"] }}
        transition={{ duration: 1.4, repeat: Infinity, ease: "easeInOut" }}
      />
    </motion.div>
  );
}

function Screenshot({ shot, accent }) {
  const [loaded, setLoaded] = useState(false);
  // Cached images can finish before React attaches onLoad — check on mount too.
  const imgRef = useCallback((node) => {
    if (node?.complete && node.naturalWidth > 0) setLoaded(true);
  }, []);

  return (
    <motion.div className="absolute inset-0" exit={{ opacity: 0 }} transition={{ duration: 0.45, ease: EASE }}>
      <AnimatePresence>{!loaded && <ScreenSkeleton key="skeleton" accent={accent} />}</AnimatePresence>
      <motion.img
        ref={imgRef}
        src={shot.src}
        alt={shot.alt}
        draggable={false}
        decoding="async"
        onLoad={() => setLoaded(true)}
        className="h-full w-full select-none object-cover"
        initial={{ opacity: 0, scale: 0.96 }}
        animate={loaded ? { opacity: 1, scale: 1 } : { opacity: 0, scale: 0.96 }}
        transition={SCREEN_ENTER}
      />
    </motion.div>
  );
}

function ScreenshotViewport({ project, accent, index, onNext }) {
  const shots = project.screenshots;

  useEffect(() => {
    shots.forEach(({ src }) => {
      const img = new Image();
      img.src = src;
    });
  }, [shots]);

  return (
    <button
      type="button"
      onClick={onNext}
      aria-label={`${project.title}: screenshot ${index + 1} of ${shots.length}. Show next`}
      className="absolute inset-0 cursor-pointer outline-none"
    >
      <AnimatePresence initial={false}>
        <Screenshot key={shots[index].src} shot={shots[index]} accent={accent} />
      </AnimatePresence>
    </button>
  );
}

function IPhone({ project, accent, shotIndex, onNextShot }) {
  const hasShots = project.screenshots?.length > 0;
  return (
    <div
      className="relative h-[640px] w-[300px] rounded-[3.25rem] p-[11px]"
      style={{
        background: "linear-gradient(145deg,#3b3e46 0%,#1b1d22 28%,#0e0f12 62%,#2d3037 100%)",
        boxShadow: `inset 0 0 0 1px rgba(255,255,255,0.09), 0 0 0 1px rgba(0,0,0,0.7), 0 50px 100px -30px rgba(0,0,0,0.95), 0 0 90px -20px ${alpha(accent, 0.5)}`,
        transition: "box-shadow 0.8s ease",
      }}
    >
      {/* Hardware buttons */}
      <span className="absolute -left-[3px] top-[112px] h-7 w-[3px] rounded-l-sm bg-[#2a2d34]" />
      <span className="absolute -left-[3px] top-[164px] h-12 w-[3px] rounded-l-sm bg-[#2a2d34]" />
      <span className="absolute -left-[3px] top-[224px] h-12 w-[3px] rounded-l-sm bg-[#2a2d34]" />
      <span className="absolute -right-[3px] top-[180px] h-20 w-[3px] rounded-r-sm bg-[#2a2d34]" />

      <div className="relative h-full w-full overflow-hidden rounded-[2.6rem] bg-black shadow-[0_0_0_2px_#000]">
        <AnimatePresence initial={false}>
          <motion.div
            key={project.id}
            className={`absolute inset-0 ${hasShots ? "bg-[#0b0d12]" : `bg-gradient-to-b ${project.phoneScreenMock.bgGradient}`}`}
            initial={{ opacity: 0, scale: 0.96 }}
            animate={{ opacity: 1, scale: 1 }}
            exit={{ opacity: 0 }}
            transition={SCREEN_ENTER}
          >
            {hasShots ? (
              <ScreenshotViewport project={project} accent={accent} index={shotIndex} onNext={onNextShot} />
            ) : (
              <>
                <div
                  className="pointer-events-none absolute -top-24 left-1/2 h-64 w-64 -translate-x-1/2 rounded-full blur-3xl"
                  style={{ background: alpha(accent, 0.22) }}
                />
                <AppScreen project={project} accent={accent} />
              </>
            )}
          </motion.div>
        </AnimatePresence>

        <StatusBar />
        <DynamicIsland project={project} accent={accent} />
        <span className="pointer-events-none absolute bottom-2 left-1/2 z-30 h-[5px] w-28 -translate-x-1/2 rounded-full bg-white/70" />
        <div className="pointer-events-none absolute inset-0 z-30 rounded-[2.6rem] bg-gradient-to-tr from-transparent via-transparent to-white/[0.06]" />
      </div>
    </div>
  );
}

function PhoneStage({ project, accent, projects, activeId, autoplay, onSelect }) {
  const mx = useMotionValue(0);
  const my = useMotionValue(0);
  const rotateX = useSpring(useTransform(my, [-0.5, 0.5], [7, -7]), { stiffness: 140, damping: 18 });
  const rotateY = useSpring(useTransform(mx, [-0.5, 0.5], [-9, 9]), { stiffness: 140, damping: 18 });

  const handleMove = (e) => {
    const rect = e.currentTarget.getBoundingClientRect();
    mx.set((e.clientX - rect.left) / rect.width - 0.5);
    my.set((e.clientY - rect.top) / rect.height - 0.5);
  };
  const reset = () => {
    mx.set(0);
    my.set(0);
  };

  // Screenshot carousel: index is scoped to the active project, so switching projects restarts at 0.
  const shots = project.screenshots ?? [];
  const [shotState, setShotState] = useState({ id: project.id, index: 0 });
  const shotIndex = shotState.id === project.id ? shotState.index : 0;
  const nextShot = () => setShotState({ id: project.id, index: (shotIndex + 1) % shots.length });

  useEffect(() => {
    if (shots.length < 2) return;
    const id = setTimeout(() => setShotState({ id: project.id, index: (shotIndex + 1) % shots.length }), SHOT_MS);
    return () => clearTimeout(id);
  }, [project.id, shotIndex, shots.length]);

  return (
    <div className="relative flex flex-col items-center py-4" onMouseMove={handleMove} onMouseLeave={reset}>
      <motion.div
        aria-hidden
        className="pointer-events-none absolute left-1/2 top-1/2 h-[420px] w-[420px] -translate-x-1/2 -translate-y-1/2 rounded-full blur-[110px]"
        animate={{ backgroundColor: alpha(accent, 0.28) }}
        transition={{ duration: 1 }}
      />
      <motion.div
        initial={{ opacity: 0, y: 40, scale: 0.96 }}
        animate={{ opacity: 1, y: 0, scale: 1 }}
        transition={{ duration: 1, ease: EASE, delay: 0.2 }}
      >
        <motion.div animate={{ y: [0, -10, 0] }} transition={{ duration: 6, repeat: Infinity, ease: "easeInOut" }}>
          <motion.div style={{ rotateX, rotateY, transformPerspective: 1200 }}>
            <IPhone project={project} accent={accent} shotIndex={shotIndex} onNextShot={nextShot} />
          </motion.div>
        </motion.div>
      </motion.div>

      <div className="relative mt-8 flex items-center gap-2" role="tablist" aria-label="Preview project">
        {projects.map((p) => {
          const isActive = p.id === activeId;
          const a = ACCENTS[p.id];
          return (
            <button
              key={p.id}
              type="button"
              role="tab"
              aria-selected={isActive}
              aria-label={`Preview ${p.title}`}
              onClick={() => onSelect(p.id)}
              className="relative h-1.5 cursor-pointer overflow-hidden rounded-full bg-white/10 transition-[width] duration-500 hover:bg-white/20"
              style={{ width: isActive ? 44 : 14 }}
            >
              {isActive && (
                <motion.span
                  key={`${p.id}-${autoplay}`}
                  className="absolute inset-y-0 left-0 rounded-full"
                  style={{ background: a.hex, boxShadow: `0 0 10px ${a.hex}` }}
                  initial={{ width: autoplay ? "0%" : "100%" }}
                  animate={{ width: "100%" }}
                  transition={{ duration: autoplay ? dwellFor(p) / 1000 : 0, ease: "linear" }}
                />
              )}
            </button>
          );
        })}
      </div>
      <p className="relative mt-3 flex items-center gap-2 font-mono text-[11px] text-slate-500">
        {autoplay ? (
          "auto-preview · hover a project to take control"
        ) : (
          <>
            previewing <span style={{ color: accent.hex }}>./{project.id}</span>
          </>
        )}
        {shots.length > 1 && (
          <span className="flex items-center gap-1" aria-label={`Screenshot ${shotIndex + 1} of ${shots.length}`}>
            <span className="text-slate-700">·</span>
            {shots.map((shot, i) => (
              <span
                key={shot.src}
                className="h-1 rounded-full transition-all duration-500"
                style={{ width: i === shotIndex ? 10 : 4, background: i === shotIndex ? accent.hex : "rgba(255,255,255,0.2)" }}
              />
            ))}
          </span>
        )}
      </p>
      <p className="relative mt-5 max-w-[320px] text-center font-mono text-[11px] leading-relaxed text-slate-500">
        <span className="text-slate-400">Disclaimer:</span> Screenshots reflect live production systems engineered and
        shipped during my professional tenure at Eleven Bay / SAS Techstudio. Trademarks belong to the respective brand
        owners.
      </p>
    </div>
  );
}

/* ────────────────────────────────────────────────────────────────────────── */
