      <motion.ul variants={stagger} initial="hidden" whileInView="show" viewport={{ once: true, margin: "-60px" }} className="mt-4 space-y-3">
        {projects.map((project, i) => (
          <ProjectRow key={project.id} project={project} index={i} active={project.id === activeId} onSelect={onSelect} />
        ))}
