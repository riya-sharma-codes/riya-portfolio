        >
          <Icon name="linkedin" className="h-4 w-4" />
          LinkedIn
        </a>
      </motion.div>

      <motion.div variants={stagger} className="mt-10 grid grid-cols-3 gap-2.5 sm:gap-3">
        {developer.stats.map((stat) => (
