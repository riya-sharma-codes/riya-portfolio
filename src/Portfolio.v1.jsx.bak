    <motion.div
      initial={{ opacity: 0, y: -10 }}
      animate={{ opacity: 1, y: 0 }}
      transition={{ duration: 0.6, ease: EASE }}
      className="flex items-center justify-between gap-4 rounded-xl border border-white/[0.06] bg-white/[0.02] px-4 py-2.5 font-mono text-[11px] text-slate-500 backdrop-blur-md"
    >
      <div className="flex min-w-0 items-center gap-3">
        <div className="flex shrink-0 gap-1.5">
          <span className="h-2.5 w-2.5 rounded-full bg-[#ff5f57]" />
          <span className="h-2.5 w-2.5 rounded-full bg-[#febc2e]" />
          <span className="h-2.5 w-2.5 rounded-full bg-[#28c840]" />
        </div>
        <span className="truncate">
          riya@portfolio<span className="text-slate-700">:</span>
          <span className="text-slate-400">~/projects/</span>
          <span style={{ color: accent.hex }} className="transition-colors duration-500">
            {activeId}
          </span>
        </span>
      </div>
      <span className="hidden shrink-0 items-center gap-2 sm:flex">
        <PulseDot color="#34d399" />
        3+ yrs · shipping
      </span>
