  "ocr-vision": { hex: "#c084fc", rgb: "192,132,252" },
};
const alpha = (accent, a) => `rgba(${accent.rgb},${a})`;

const EASE = [0.22, 1, 0.36, 1];
const AUTOPLAY_MS = 5500;
const SHOT_MS = 2800;
const dwellFor = (project) => Math.max(AUTOPLAY_MS, (project.screenshots?.length ?? 0) * SHOT_MS);

const SCREEN_ENTER = {
  scale: { type: "spring", stiffness: 260, damping: 26, mass: 0.9 },
  opacity: { duration: 0.45, ease: EASE },
};

const stagger = { hidden: {}, show: { transition: { staggerChildren: 0.08, delayChildren: 0.1 } } };
const fadeUp = {
  hidden: { opacity: 0, y: 16 },
  show: { opacity: 1, y: 0, transition: { duration: 0.7, ease: EASE } },
};
const screenStagger = { hidden: {}, show: { transition: { staggerChildren: 0.1, delayChildren: 0.18 } } };
const screenItem = {
  hidden: { opacity: 0, y: 14, scale: 0.98 },
  show: { opacity: 1, y: 0, scale: 1, transition: { duration: 0.55, ease: EASE } },
};

