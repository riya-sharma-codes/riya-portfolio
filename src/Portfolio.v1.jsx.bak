      <div className="mt-12 rounded-2xl border border-white/[0.06] bg-white/[0.015] p-5 font-mono text-xs">
        <p className="text-slate-500">
          <span style={{ color: accent.hex }}>➜</span> <span className="text-slate-400">~</span> contact --open
        </p>
