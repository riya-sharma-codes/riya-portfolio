      <footer className="mt-8 font-mono text-[11px] text-slate-600">
        © {new Date().getFullYear()} {developer.name} · React · Tailwind CSS · Framer Motion
      </footer>
    </section>
  );
}

function Backdrop({ accent }) {
  return (
    <div aria-hidden className="pointer-events-none fixed inset-0 overflow-hidden">
      <div
        className="absolute inset-0"
        style={{
          backgroundImage:
            "linear-gradient(rgba(255,255,255,0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.035) 1px, transparent 1px)",
          backgroundSize: "48px 48px",
          maskImage: "radial-gradient(ellipse 80% 60% at 50% 0%, black 30%, transparent 80%)",
          WebkitMaskImage: "radial-gradient(ellipse 80% 60% at 50% 0%, black 30%, transparent 80%)",
        }}
      />
      <motion.div
        className="absolute -right-40 top-1/4 h-[560px] w-[560px] rounded-full blur-[150px]"
        animate={{ backgroundColor: alpha(accent, 0.16) }}
        transition={{ duration: 1.2 }}
      />
      <div className="absolute -left-48 -top-48 h-[520px] w-[520px] rounded-full bg-indigo-500/10 blur-[150px]" />
    </div>
  );
}

/* ────────────────────────────────────────────────────────────────────────── */
/* Scroll climber                                                            */
/* ────────────────────────────────────────────────────────────────────────── */

const TRAIL = { from: "#2dd4bf", to: "#3b82f6", rgb: "45,212,191" };
const HAIR = "#fda4af";
const SKIN = "#e2e8f0";
// Projects run newest → oldest, so the top of the page is the summit (the present)
// and scrolling down walks her back through earlier work.
const SUMMIT_UNTIL = 0.04;
const CLIMB_CYCLES = 14;

// Centre of the 4rem column gap: wrapper is max-w-7xl with lg:px-10, columns are 1.1fr / 0.9fr.
const GUTTER_CENTER = "calc(50% - min(100%, 80rem) / 2 + 4.5rem + (min(100%, 80rem) - 9rem) * 0.55)";

// Layout of the rail, in px from the top of the viewport (clears the console bar at scroll 0).
const PEAK_TOP = 124;
const PEAK_H = 28;
const APEX_Y = PEAK_TOP + 2;
const TRACK_TOP = PEAK_TOP + PEAK_H;

const glow = (a) => `drop-shadow(0 0 6px rgba(${TRAIL.rgb},${a}))`;

const legPath = (hipX, kneeX, footX, footY) => `M${hipX} 27 L${kneeX} ${(27 + footY) / 2 - 1} L${footX} ${footY}`;

function useLimbs(phase) {
  const s = useTransform(phase, Math.sin);
  const leftLeg = useTransform(s, (v) => legPath(14.5, 10, 15, 42 + 3 * v));
  const rightLeg = useTransform(s, (v) => legPath(17.5, 22, 17, 42 - 3 * v));
  return {
    s,
    leftLeg,
    rightLeg,
    sway: useTransform(phase, (v) => Math.sin(v / 2) * 4),
    ponytail: useTransform(phase, (v) => {
      const swing = Math.sin(v / 2) * 2;
      return `M18.6 6.8 Q${22 + swing} 9 ${20.5 + swing} 14.5`;
    }),
  };
}

/** Scrolling up: back to the viewer, backpack on, reaching for the summit. */
function ClimbingFigure({ phase }) {
  const { s, leftLeg, rightLeg, sway, ponytail } = useLimbs(phase);
  const leftArm = useTransform(s, (v) => {
    const y = 6 - 4 * v;
    return `M13.5 15 Q9.5 ${(15 + y) / 2} 15 ${y}`;
  });
  const rightArm = useTransform(s, (v) => {
    const y = 6 + 4 * v;
    return `M18.5 15 Q22.5 ${(15 + y) / 2} 17 ${y}`;
  });

  return (
    <motion.svg viewBox="0 0 32 48" className="h-12 w-8 overflow-visible" style={{ rotate: sway, originY: 0.1, filter: glow(0.55) }}>
      <g fill="none" stroke={SKIN} strokeWidth="2.4" strokeLinecap="round" strokeLinejoin="round">
        <motion.path d={leftLeg} />
        <motion.path d={rightLeg} />
        <path d="M16 13V27" />
        <motion.path d={leftArm} />
        <motion.path d={rightArm} />
      </g>
      <rect x="12.5" y="14.5" width="7" height="9" rx="2" fill={TRAIL.from} />
      <circle cx="16" cy="9" r="3.6" fill={SKIN} />
      <path d="M12.6 8.6 Q16 4 19.4 8.6" fill="none" stroke={HAIR} strokeWidth="2.2" strokeLinecap="round" />
      <motion.path d={ponytail} fill="none" stroke={HAIR} strokeWidth="2.2" strokeLinecap="round" />
    </motion.svg>
  );
}

/** Scrolling down: turned to face the viewer, easing down while gazing back up at the peak. */
function ReminiscingFigure({ phase }) {
  const { s, leftLeg, rightLeg, sway, ponytail } = useLimbs(phase);
  const leftArm = useTransform(s, (v) => `M13.5 15 Q11.5 ${9 + v} 15 ${3 + 1.5 * v}`);
  const rightArm = useTransform(s, (v) => `M18.5 15 Q20.5 ${9 - v} 17 ${3 - 1.5 * v}`);

  return (
    <div className="relative">
      <motion.svg viewBox="0 0 32 48" className="h-12 w-8 overflow-visible" style={{ rotate: sway, originY: 0.1, filter: glow(0.45) }}>
        <g fill="none" stroke={SKIN} strokeWidth="2.4" strokeLinecap="round" strokeLinejoin="round">
          <motion.path d={leftLeg} />
          <motion.path d={rightLeg} />
          <path d="M16 13.5V27" />
          <motion.path d={leftArm} />
          <motion.path d={rightArm} />
        </g>
        <path d="M14 14.5 L14.6 22M18 14.5 L17.4 22" stroke={TRAIL.from} strokeWidth="1.4" strokeLinecap="round" />
        <motion.path d={ponytail} fill="none" stroke={HAIR} strokeWidth="2.2" strokeLinecap="round" />
        <circle cx="16" cy="10" r="3.6" fill={SKIN} />
        <path d="M12.6 9.4 Q16 4.8 19.4 9.4" fill="none" stroke={HAIR} strokeWidth="2.2" strokeLinecap="round" />
        {/* Eyes set high — she's looking back up at where she's been. */}
        <circle cx="14.8" cy="9.4" r="0.6" fill="#0f172a" />
        <circle cx="17.2" cy="9.4" r="0.6" fill="#0f172a" />
      </motion.svg>

      {/* Thought bubble */}
      <motion.span
        className="absolute -left-3 -top-3 flex items-end gap-[2px]"
        initial={{ opacity: 0, scale: 0.6 }}
        animate={{ opacity: 1, scale: 1 }}
        transition={{ delay: 0.15, duration: 0.3 }}
      >
        <motion.span
          className="grid h-3.5 w-3.5 place-items-center rounded-full border border-teal-300/40 bg-slate-900/80 text-[7px] leading-none text-teal-200"
          animate={{ y: [0, -2, 0] }}
          transition={{ duration: 2.2, repeat: Infinity, ease: "easeInOut" }}
        >
          ✦
        </motion.span>
        <span className="mb-[1px] h-1 w-1 rounded-full bg-teal-300/50" />
      </motion.span>
    </div>
  );
}

/** Top of the page: planted flag, hand shading her eyes, looking ahead. */
function SummitFigure() {
  return (
    <svg viewBox="0 0 40 44" className="h-11 w-10 overflow-visible" style={{ filter: glow(0.6) }}>
      <path d="M31 5V44" stroke="#94a3b8" strokeWidth="1.4" strokeLinecap="round" />
      <motion.path
        fill={TRAIL.from}
        d="M31 5 Q35 3.5 39 7 Q35 9 31 11Z"
        style={{ originX: "31px", originY: "8px", transformBox: "view-box" }}
        animate={{ skewY: [0, 8, 0], scaleX: [1, 0.86, 1] }}
        transition={{ duration: 1.6, repeat: Infinity, ease: "easeInOut" }}
      />
      <g fill="none" stroke={SKIN} strokeWidth="2.4" strokeLinecap="round" strokeLinejoin="round">
        <path d="M20 30 L16 43.5M20 30 L24 43.5" />
        <path d="M20 16V30" />
        <path d="M20 19 L26 22 L31 20" />
        <path d="M19.5 18.5 L14.5 15 L22.5 10.5" />
      </g>
      <rect x="14" y="16.5" width="5" height="9" rx="1.8" fill={TRAIL.from} />
      <motion.path
        fill="none"
        stroke={HAIR}
        strokeWidth="2.2"
        strokeLinecap="round"
        d="M18 9.5 Q13 10 12.5 15"
        style={{ originX: "18px", originY: "9.5px", transformBox: "view-box" }}
        animate={{ rotate: [0, 10, 0] }}
        transition={{ duration: 1.6, repeat: Infinity, ease: "easeInOut" }}
      />
      <circle cx="20.5" cy="11.5" r="3.5" fill={SKIN} />
      <path d="M17.2 11 Q19.5 6.8 23.8 10" fill="none" stroke={HAIR} strokeWidth="2.2" strokeLinecap="round" />
    </svg>
  );
}

function SummitBurst() {
  return (
    <span className="absolute left-1/2" style={{ top: APEX_Y }}>
      {Array.from({ length: 8 }, (_, i) => {
        const angle = (i / 8) * Math.PI * 2;
        return (
          <motion.span
            key={i}
            className="absolute h-1 w-1 rounded-full"
            style={{ background: i % 2 ? TRAIL.to : TRAIL.from, boxShadow: `0 0 6px ${TRAIL.from}` }}
            initial={{ x: -2, y: -2, opacity: 1, scale: 1 }}
            animate={{ x: Math.cos(angle) * 26 - 2, y: Math.sin(angle) * 26 - 2, opacity: 0, scale: 0.4 }}
            transition={{ duration: 0.9, ease: EASE, delay: 0.15 }}
          />
        );
      })}
    </span>
  );
}

// Quick "turn around" when she switches between facing the rope and facing the viewer.
const turn = {
  initial: { opacity: 0, rotateY: -90 },
  animate: { opacity: 1, rotateY: 0, transition: { duration: 0.18, ease: EASE } },
  exit: { opacity: 0, rotateY: 90, transition: { duration: 0.14 } },
};

function ScrollClimber() {
  const { scrollY, scrollYProgress } = useScroll();
  const progress = useSpring(scrollYProgress, { stiffness: 120, damping: 24, mass: 0.4 });
  const top = useTransform(progress, [SUMMIT_UNTIL, 1], ["0%", "100%"]);
  const phase = useTransform(progress, (v) => v * CLIMB_CYCLES * Math.PI * 2);
  const ropeOffset = useTransform(progress, [0, 1], [0, 240]);

  const [summit, setSummit] = useState(true);
  const [direction, setDirection] = useState("down");

  useEffect(() => setSummit(scrollYProgress.get() <= SUMMIT_UNTIL), [scrollYProgress]);
  useMotionValueEvent(scrollYProgress, "change", (v) => setSummit(v <= SUMMIT_UNTIL));
  useMotionValueEvent(scrollY, "change", (y) => {
    const delta = y - (scrollY.getPrevious() ?? y);
    if (Math.abs(delta) > 1) setDirection(delta > 0 ? "down" : "up");
  });

  return (
    <div
      aria-hidden
      className="pointer-events-none fixed inset-y-0 z-10 hidden w-16 -translate-x-1/2 lg:block"
      style={{ left: GUTTER_CENTER }}
    >
      {/* Peak */}
      <svg viewBox="0 0 56 28" className="absolute left-1/2 w-14 -translate-x-1/2 overflow-visible" style={{ top: PEAK_TOP, height: PEAK_H }}>
        <defs>
          <linearGradient id="climber-peak" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stopColor="#334155" />
            <stop offset="1" stopColor="#334155" stopOpacity="0" />
          </linearGradient>
        </defs>
        <path d="M0 28 L20 8 L28 2 L34 8 L42 4 L56 28Z" fill="url(#climber-peak)" />
        <motion.path
          d="M0 28 L20 8 L28 2 L34 8 L42 4 L56 28"
          fill="none"
          strokeWidth="1.2"
          strokeLinejoin="round"
          animate={{ stroke: summit ? TRAIL.from : "rgba(255,255,255,0.14)" }}
          transition={{ duration: 0.6 }}
          style={summit ? { filter: `drop-shadow(0 0 4px ${TRAIL.from})` } : undefined}
        />
        <path d="M24.5 5 L28 2 L31.5 5.5 L28 4.5Z" fill="rgba(255,255,255,0.55)" />
      </svg>

      {/* Rope, with the stretch she's travelled from the summit lit up */}
      <div className="absolute inset-x-0 bottom-10" style={{ top: TRACK_TOP }}>
        <svg
          className="absolute bottom-0 left-1/2 w-2 -translate-x-1/2 overflow-visible"
          style={{ top: -(PEAK_H - 2), height: `calc(100% + ${PEAK_H - 2}px)` }}
        >
          <line x1="4" x2="4" y1="0" y2="100%" stroke="rgba(255,255,255,0.09)" strokeWidth="2" />
          <motion.line
            x1="4"
            x2="4"
            y1="0"
            y2="100%"
            stroke="rgba(255,255,255,0.16)"
            strokeWidth="2"
            strokeDasharray="1.5 5"
            strokeLinecap="round"
            style={{ strokeDashoffset: ropeOffset }}
          />
        </svg>

        <motion.div
          className="absolute left-1/2 w-[2px] -translate-x-1/2 rounded-full"
          style={{
            top: -(PEAK_H - 2),
            height: PEAK_H - 2,
            background: TRAIL.from,
            boxShadow: `0 0 12px rgba(${TRAIL.rgb},0.7)`,
          }}
          animate={{ opacity: summit ? 0 : 1 }}
        />
        <motion.div
          className="absolute left-1/2 top-0 w-[2px] -translate-x-1/2 rounded-b-full"
          style={{
            height: top,
            background: `linear-gradient(180deg, ${TRAIL.from}, ${TRAIL.to})`,
            boxShadow: `0 0 12px rgba(${TRAIL.rgb},0.7), 0 0 2px rgba(${TRAIL.rgb},0.9)`,
          }}
          animate={{ opacity: summit ? 0 : 1 }}
        />

        <AnimatePresence>
          {!summit && (
            <motion.div
              key="traveller"
              className="absolute left-1/2"
              style={{ top, x: "-50%", y: "-10%", perspective: 400 }}
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              exit={{ opacity: 0, scale: 0.6, transition: { duration: 0.25 } }}
            >
              <AnimatePresence mode="wait" initial={false}>
                <motion.div key={direction} {...turn}>
                  {direction === "down" ? <ReminiscingFigure phase={phase} /> : <ClimbingFigure phase={phase} />}
                </motion.div>
              </AnimatePresence>
            </motion.div>
          )}
        </AnimatePresence>
      </div>

      {/* Summit — the present */}
      <AnimatePresence>
        {summit && (
          <motion.div key="summit" className="absolute inset-0" exit={{ opacity: 0, transition: { duration: 0.25 } }}>
            <motion.span
              className="absolute left-1/2 h-10 w-10 -translate-x-1/2 -translate-y-1/2 rounded-full blur-md"
              style={{ top: APEX_Y, background: `rgba(${TRAIL.rgb},0.35)` }}
              animate={{ scale: [0.8, 1.25, 0.8], opacity: [0.5, 0.9, 0.5] }}
              transition={{ duration: 2.4, repeat: Infinity, ease: "easeInOut" }}
            />
            <SummitBurst />
            <motion.div
              className="absolute left-1/2"
              style={{ top: APEX_Y - 44, x: "-50%" }}
              initial={{ opacity: 0, y: 14, scale: 0.8 }}
              animate={{ opacity: 1, y: 0, scale: 1 }}
              transition={{ type: "spring", stiffness: 260, damping: 20 }}
            >
              <SummitFigure />
            </motion.div>
            <motion.p
              className="absolute font-mono text-[10.5px] tracking-[0.18em] text-teal-200/85"
              style={{
                top: TRACK_TOP + 16,
                left: "calc(50% + 9px)",
                writingMode: "vertical-rl",
                textShadow: `0 0 10px rgba(${TRAIL.rgb},0.6)`,
              }}
              initial={{ opacity: 0, y: -12 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ delay: 0.35, duration: 0.7, ease: EASE }}
            >
              Looking forward to the next adventure!
            </motion.p>
          </motion.div>
        )}
      </AnimatePresence>
    </div>
  );
}

/* ────────────────────────────────────────────────────────────────────────── */
/* Page                                                                      */
/* ────────────────────────────────────────────────────────────────────────── */

export default function Portfolio() {
  const { projects } = PROFILE;
  const [activeId, setActiveId] = useState(projects[0].id);
  const [autoplay, setAutoplay] = useState(true);

  const project = projects.find((p) => p.id === activeId);
  const accent = ACCENTS[activeId];

  useEffect(() => {
    if (!autoplay) return;
    const id = setTimeout(() => {
      const next = (projects.findIndex((p) => p.id === activeId) + 1) % projects.length;
      setActiveId(projects[next].id);
    }, dwellFor(project));
    return () => clearTimeout(id);
  }, [autoplay, activeId, project, projects]);

  const select = (id) => {
    setAutoplay(false);
    setActiveId(id);
  };

  return (
    <MotionConfig reducedMotion="user">
      <div className="relative min-h-screen overflow-x-clip bg-[#05060a] font-sans text-slate-200 antialiased selection:bg-white/20">
        <Backdrop accent={accent} />
        <ScrollClimber />

        <div className="relative mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-10 lg:py-8">
          <ConsoleBar activeId={activeId} accent={accent} />

          <main className="mt-12 grid gap-12 lg:mt-16 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-x-16 lg:gap-y-14">
            <div className="lg:col-start-1 lg:row-start-1">
              <Intro accent={accent} />
            </div>

            <aside className="lg:col-start-2 lg:row-span-2 lg:row-start-1">
              <div className="lg:sticky lg:top-8">
                <PhoneStage
                  project={project}
                  accent={accent}
                  projects={projects}
                  activeId={activeId}
                  autoplay={autoplay}
                  onSelect={select}
                />
              </div>
            </aside>

            <div className="lg:col-start-1 lg:row-start-2">
              <Projects activeId={activeId} accent={accent} onSelect={select} />
            </div>
          </main>
        </div>
      </div>
    </MotionConfig>
  );
}
