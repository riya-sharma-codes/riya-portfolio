            <span className="text-slate-200 underline-offset-4 group-hover:underline">{developer.contact.email}</span>
          </a>
          <a href={developer.contact.linkedin} target="_blank" rel="noreferrer" className="group flex gap-3 text-slate-500 transition-colors hover:text-slate-300">
            <span className="w-16 text-slate-600">linkedin</span>
            <span className="text-slate-200 underline-offset-4 group-hover:underline">
              {developer.contact.linkedin.replace(/^https?:\/\//, "")}
