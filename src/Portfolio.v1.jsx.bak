}

function ProjectRow({ project, index, active, onSelect }) {
  const accent = ACCENTS[project.id];
  const ref = useRef(null);

  const trackSpotlight = (e) => {
    const rect = ref.current.getBoundingClientRect();
    ref.current.style.setProperty("--x", `${e.clientX - rect.left}px`);
    ref.current.style.setProperty("--y", `${e.clientY - rect.top}px`);
  };

  return (
    <motion.li variants={fadeUp}>
      <button
        ref={ref}
        type="button"
        aria-pressed={active}
        onMouseEnter={() => onSelect(project.id)}
        onFocus={() => onSelect(project.id)}
        onClick={() => onSelect(project.id)}
        onMouseMove={trackSpotlight}
        className="group relative w-full cursor-pointer overflow-hidden rounded-2xl border p-5 text-left outline-none transition-[border-color,background,box-shadow] duration-500 focus-visible:ring-2 focus-visible:ring-white/30"
        style={{
          borderColor: active ? alpha(accent, 0.35) : "rgba(255,255,255,0.06)",
          background: active
            ? `linear-gradient(135deg, ${alpha(accent, 0.09)}, rgba(255,255,255,0.012) 60%)`
            : "rgba(255,255,255,0.012)",
          boxShadow: active ? `0 24px 60px -32px ${alpha(accent, 0.7)}` : "none",
        }}
      >
        <span
          aria-hidden
          className="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
          style={{ background: `radial-gradient(260px circle at var(--x) var(--y), ${alpha(accent, 0.12)}, transparent 65%)` }}
        />
        {active && (
          <motion.span
            layoutId="active-rail"
            className="absolute bottom-5 left-0 top-5 w-[2px] rounded-full"
            style={{ background: accent.hex, boxShadow: `0 0 12px ${accent.hex}` }}
            transition={{ type: "spring", stiffness: 400, damping: 34 }}
          />
        )}

        <div className="relative flex items-start gap-4">
          <span
            className="pt-1 font-mono text-xs transition-colors duration-500"
            style={{ color: active ? accent.hex : "rgb(71,85,105)" }}
          >
            {String(index + 1).padStart(2, "0")}
          </span>
          <div className="min-w-0 flex-1">
            <div className="flex items-center justify-between gap-3">
              <h3 className="text-base font-semibold tracking-tight text-white sm:text-lg">{project.title}</h3>
              <Icon
                name="arrowUpRight"
                className={`h-4 w-4 shrink-0 transition-all duration-300 ${active ? "translate-x-0 opacity-100" : "-translate-x-1 opacity-0 group-hover:opacity-60"}`}
                style={{ color: accent.hex }}
              />
            </div>
            <p className={`mt-1 font-mono text-[11px] uppercase tracking-[0.14em] ${project.phoneScreenMock.accentColor} ${active ? "opacity-100" : "opacity-70"}`}>
              {project.subtitle}
            </p>
            <p className="mt-3 text-sm leading-relaxed text-slate-400">{project.description}</p>
            <div className="mt-4 flex flex-wrap gap-1.5">
              {project.tech.map((t) => (
                <span
                  key={t}
                  className="rounded-md border px-2 py-0.5 font-mono text-[10.5px] transition-colors duration-500"
                  style={{
                    borderColor: active ? alpha(accent, 0.25) : "rgba(255,255,255,0.07)",
                    color: active ? "rgb(226,232,240)" : "rgb(148,163,184)",
                    background: active ? alpha(accent, 0.06) : "transparent",
                  }}
                >
                  {t}
                </span>
              ))}
            </div>
          </div>
        </div>
      </button>
    </motion.li>
  );
}

function Projects({ activeId, accent, onSelect }) {
