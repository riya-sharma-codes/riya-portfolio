}

function StatCard({ stat }) {
  const [main, ...suffix] = stat.value.split(" ");
  return (
    <motion.div
      variants={fadeUp}
      whileHover={{ y: -3 }}
      className="group relative overflow-hidden rounded-2xl border border-white/[0.06] bg-white/[0.02] p-3.5 transition-colors hover:border-white/[0.14] hover:bg-white/[0.035] sm:p-4"
    >
      <div className="pointer-events-none absolute -right-8 -top-8 h-20 w-20 rounded-full bg-white/[0.04] blur-2xl transition group-hover:bg-white/[0.08]" />
      <Icon name={stat.icon} className="h-4 w-4 text-slate-500 transition-colors group-hover:text-slate-200" />
      <p className="mt-4 flex items-baseline gap-1 text-2xl font-semibold tracking-tight text-white sm:text-3xl">
        {main}
        {suffix.length > 0 && <span className="text-sm font-medium text-slate-400 sm:text-base">{suffix.join(" ")}</span>}
      </p>
      <p className="mt-1 text-[11px] leading-snug text-slate-500 sm:text-xs">{stat.label}</p>
    </motion.div>
  );
}

function Intro({ accent }) {
